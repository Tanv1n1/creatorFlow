syntax=docker/dockerfile:1
FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .

# Cloud Run injects $PORT; uvicorn reads it via the CMD below.
ENV PORT=8000
EXPOSE 8000

CMD ["sh", "-c", "uvicorn creatorflow.main:app --host 0.0.0.0 --port ${PORT}"]
